{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Otel": {
    "ServiceName": "sample-api",
    "ServiceVersion": "1.0.0",
    "Environment": "development",
    "Protocol": "HttpProtobuf",
    "Endpoint": {
      "Default": "http://localhost:4318",
      "Traces": "http://localhost:4318/v1/traces",
      "Metrics": "http://localhost:4318/v1/metrics"
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/company",
    "Audience": "portal-api",
    "RequireHttpsMetadata": false,
    "Realm": "company",
    "ClientId": "portal-api",
    "TokenEndpoint": "http://localhost:8080/realms/company/protocol/openid-connect/token",
    "ValidIssuers": "http://localhost:8080/realms/company;http://keycloak:8080/realms/company"
  }
}
