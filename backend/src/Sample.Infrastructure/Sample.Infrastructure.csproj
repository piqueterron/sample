<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- EF Core migrations are generated with usings outsidethe namespace
         (IDE0065) and with explicit `using System;` (IDE0005). Suppress these
         two analyzer rules only on this project so the rest of the solution
         still enforces EnforceCodeStyleInBuild. The alternative - rewriting
         the generated files - is fragile because `dotnet ef migrations add`
         regenerates them from scratch. -->
    <NoWarn>$(NoWarn);IDE0065</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Analyzers" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sample.Application\Sample.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Sample.Application.Abstractions" />
  </ItemGroup>

</Project>
