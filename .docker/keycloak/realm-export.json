{
  "realm": "company",
  "enabled": true,
  "displayName": "Company Realm",

  "roles": {
    "realm": [
      {
        "name": "admin"
      },
      {
        "name": "user"
      }
    ]
  },

  "clients": [
    {
      "clientId": "portal-api",
      "name": "Portal API",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",

      "redirectUris": [
        "http://localhost:5156/*",
        "http://localhost:3000/*",
        "http://localhost:8080/*"
      ],

      "webOrigins": [
        "http://localhost:5156",
        "http://localhost:3000",
        "http://localhost:8080"
      ],

      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,

      "protocolMappers": [
        {
          "name": "audience-portal-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "portal-api",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "backoffice-web",
      "name": "Backoffice SPA (PKCE)",
      "description": "Authorization Code flow with PKCE for the React SPA. Public client (no client secret).",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",

      "rootUrl": "http://localhost:5173",
      "adminUrl": "http://localhost:5173",

      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:4173/*"
      ],

      "webOrigins": [
        "+",
        "http://localhost:5173",
        "http://localhost:4173"
      ],

      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,

      "attributes": {
        "pkce.code.challenge.method": "S256",
        "client_credentials.use_refresh_token": "false",
        "legacy_id_token_claims": "false",
        "use.refresh.tokens": "true"
      },

      "protocolMappers": [
        {
          "name": "audience-backoffice",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "portal-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@example.com",

      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],

      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "test",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "test@example.com",

      "credentials": [
        {
          "type": "password",
          "value": "Password123!",
          "temporary": false
        }
      ],

      "realmRoles": [
        "user"
      ]
    }
  ]
}