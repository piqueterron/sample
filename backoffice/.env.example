# Local overrides - not committed. Copy to ".env.local" (or ".env" in dev mode)
# and adjust. These values mirror backoffice/.env; only override what differs.
#
# NOTE: VITE_* vars are inlined into the client bundle at BUILD time (npm run dev
# / npm run build). When running the SPA inside Docker the build args in
# .docker/docker-compose.override.yml already bake host-reachable URLs
# (http://localhost:*) into the bundle, so this file is mainly for `npm run dev`.

# Public OIDC client configured in .docker/keycloak/realm-export.json.
VITE_OIDC_CLIENT_ID=backoffice-web

# Keycloak realm - matches "company" in realm-export.json.
VITE_OIDC_REALM=company

# When running on the host (npm run dev), Keycloak is exposed on http://localhost:8080.
# When running in Docker, override via the build args in docker-compose.override.yml.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/company

# SPA URL - must match the redirectUris of the backoffice-web client in realm-export.json.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/

# Optional: dev-only proxy target for /api/* calls (defaults to http://localhost:5157).
VITE_API_PROXY_TARGET=http://localhost:5157
