# Local overrides - not committed. Copy from .env and adjust.
# Example for running the SPA in Docker, where Keycloak is reachable at http://keycloak:8080
# but the browser (host) needs http://localhost:8080.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/company
VITE_OIDC_REDIRECT_URI=http://localhost:5173/
VITE_API_PROXY_TARGET=http://localhost:5157
