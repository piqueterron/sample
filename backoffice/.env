# OIDC / Keycloak configuration for the backoffice SPA.
# These are loaded by Vite and exposed to the client bundle on build. They are
# NOT secret: this is a public PKCE client and the client id is published in the
# browser anyway (the only credential is the user's password and the PKCE code
# verifier, which never leaves the browser).

# Public OIDC client configured in .docker/keycloak/realm-export.json.
VITE_OIDC_CLIENT_ID=backoffice-web

# Keycloak realm - matches "company" in realm-export.json.
VITE_OIDC_REALM=company

# When running the SPA on the host (npm run dev), Keycloak is exposed on http://localhost:8080.
# When running in Docker (npm run preview / container), Keycloak is reached via env override.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/company

# SPA URL - must match the redirectUris of the backoffice-web client in realm-export.json.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/

# Optional: dev-only proxy target for /api/* calls (defaults to http://localhost:5157).
VITE_API_PROXY_TARGET=http://localhost:5157
